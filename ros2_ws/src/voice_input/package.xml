<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voice_input</name>
  <version>0.1.0</version>
  <description>Ses girisi (Faz 3): mikrofon / WAV -> Silero VAD -> faster-whisper STT -> /voice/stt. Kayit, STT karsilastirma ve uctan uca ses testi araclari.</description>
  <maintainer email="atobasgan33@gmail.com">atobasgan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>drone_interfaces</exec_depend>
  <exec_depend>command_parser</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pip ile (scripts/ses_kur.sh): faster-whisper, silero-vad (+ torch CPU), sounddevice -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
